rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /students/{id} {
      allow read: if true;
      allow create: if request.resource.data.stamps.size() == 0
                    && request.resource.data.entered == false
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stamps', 'entered', 'enteredAt'])
                    && request.resource.data.stamps.size() >= resource.data.stamps.size()
                    && request.resource.data.stamps.size() <= resource.data.stamps.size() + 1
                    && request.resource.data.stamps.size() <= 5
                    && (request.resource.data.entered == resource.data.entered
                        || (resource.data.entered == false
                            && request.resource.data.entered == true
                            && request.resource.data.stamps.size() == 5));
      allow delete: if false;
    }

    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /draws/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
